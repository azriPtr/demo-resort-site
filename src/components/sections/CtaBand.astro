---
import Button from '../ui/Button.astro';

/** Closing call to action on a dark band. One action, one sentence of support. */
interface Props {
  title: string;
  text?: string;
  cta: { label: string; href: string; external?: boolean };
}

const { title, text, cta } = Astro.props;
---

<section class="border-b border-line-dark bg-dark text-ondark">
  <div class="wrap flex flex-wrap items-end justify-between gap-x-16 gap-y-8 py-[clamp(4rem,8vw,7rem)]">
    <div class="flex-[1_1_min(100%,35rem)]">
      <h2 class="display max-w-[20ch] text-[clamp(2rem,1.5rem+1.9vw,3.25rem)] leading-[1.08]">{title}</h2>
      {text && <p class="mt-[1.125rem] max-w-[52ch] text-[clamp(1rem,0.95rem+0.2vw,1.125rem)] text-ondark-muted">{text}</p>}
    </div>
    <Button {...cta} variant="onDark" size="lg" />
  </div>
</section>
