---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';

/**
 * Photo grid: the first photo takes a 2x2 block, the rest fill single cells
 * of a fixed row height. Five photos fill it exactly from 768px up. Every
 * image needs alt text that says what is in it.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  images: { image: ImageMetadata; alt: string }[];
}

const { eyebrow, title, images } = Astro.props;
---

<section class="section-y">
  <div class="wrap">
    {title && <SectionHeading eyebrow={eyebrow} title={title} />}
    <ul
      class:list={[
        'grid auto-rows-[clamp(9.375rem,17vw,16.875rem)] grid-flow-dense grid-cols-2 gap-[clamp(0.5rem,1vw,1rem)] md:grid-cols-4',
        title && 'mt-[clamp(1.75rem,3.5vw,3rem)]',
      ]}
    >
      {
        images.map((img, i) => (
          <li class:list={[i === 0 && 'col-span-2 row-span-2']}>
            <Image
              src={img.image}
              alt={img.alt}
              widths={[360, 720, 1080]}
              sizes={i === 0 ? '(min-width: 48rem) 50vw, 100vw' : '(min-width: 48rem) 25vw, 50vw'}
              class="h-full w-full rounded-card bg-base-alt object-cover"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
