---
import { formatDays, type Hours } from '../../lib/facts';

/**
 * Opening hours from facts, as a row of tiles: the days in bold, the times
 * large in the display face, under an accent rule.
 */
interface Props {
  hours: Hours[];
  label?: string;
}

const { hours, label = 'Opening hours' } = Astro.props;
---

<div>
  <p class="eyebrow text-brand">{label}</p>
  <dl class="mt-4 grid grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))] gap-x-[clamp(1.25rem,3vw,2.5rem)]">
    {
      hours.map((h) => (
        <div class="border-t-2 border-brand py-5">
          <dt class="font-semibold">{formatDays(h.days)}</dt>
          <dd class="display mt-1 text-[clamp(1.625rem,1.4rem+0.8vw,2rem)] leading-tight tabular-nums">
            {h.opens}–{h.closes}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
