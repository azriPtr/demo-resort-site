---
import SectionHeading from '../ui/SectionHeading.astro';
import { facts } from '../../lib/facts';

/**
 * Questions from facts.faq. Answers are policies the client confirmed, so
 * they live in facts. Pair with faqNode() in the page's jsonLd so the
 * visible answers and the FAQPage markup are the same text.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  items?: { q: string; a: string }[];
}

const { eyebrow, title = 'Questions', items = facts.faq } = Astro.props;
---

{
  items.length > 0 && (
    <section class="section-y">
      <div class="wrap grid gap-6 lg:grid-cols-[1fr_2fr] lg:gap-[clamp(2rem,6vw,6rem)]">
        <SectionHeading eyebrow={eyebrow} title={title} />
        <div class="divide-y divide-line border-y border-line">
          {items.map((item) => (
            <details class="group">
              <summary class="display flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-5 text-[clamp(1.1875rem,1.1rem+0.35vw,1.375rem)] leading-snug [&::-webkit-details-marker]:hidden">
                {item.q}
                <span aria-hidden="true" class="flex-none font-sans text-2xl leading-none text-brand">
                  <span class="group-open:hidden">+</span>
                  <span class="hidden group-open:inline">−</span>
                </span>
              </summary>
              <p class="mb-6 max-w-[62ch] text-ink-muted">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
