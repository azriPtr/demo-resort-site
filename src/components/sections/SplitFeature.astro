---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';

/**
 * Photo beside copy. Use for one idea per block (the restaurant, the spa,
 * the rice-field view), alternating `reverse` down the page. The first
 * paragraph of the slot reads in ink, the rest in the muted colour.
 */
interface Props {
  image: ImageMetadata;
  alt: string;
  eyebrow?: string;
  title: string;
  cta?: { label: string; href: string; external?: boolean };
  reverse?: boolean;
  tone?: 'base' | 'alt';
}

const { image, alt, eyebrow, title, cta, reverse = false, tone = 'base' } = Astro.props;
---

<section class:list={['section-y', tone === 'alt' ? 'bg-base-alt' : 'bg-base']}>
  <div class="wrap grid items-center gap-9 md:grid-cols-[1.2fr_1fr] md:gap-[clamp(2.5rem,6vw,6rem)]">
    <Image
      src={image}
      alt={alt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 48rem) 50vw, 100vw"
      class:list={['aspect-[5/4] w-full rounded-card bg-base-alt object-cover', reverse && 'md:order-2']}
    />
    <div class="max-w-[52ch]">
      {eyebrow && <p class="eyebrow mb-4 text-brand">{eyebrow}</p>}
      <h2 class="display text-h2">{title}</h2>
      <div class="copy mt-6 [&>*+*]:text-ink-muted">
        <slot />
      </div>
      {cta && <Button {...cta} variant="secondary" class="mt-8" />}
    </div>
  </div>
</section>
