---
import SectionHeading from '../ui/SectionHeading.astro';

/**
 * Opening copy for a page: heading on the left, copy on the right, and an
 * optional row of key facts underneath (number of villas, check-in time,
 * distance). Pass fact values from client/facts.yaml, not typed into the page.
 */
interface Props {
  eyebrow?: string;
  title: string;
  keyFacts?: { label: string; value: string }[];
}

const { eyebrow, title, keyFacts = [] } = Astro.props;
---

<section class="section-y">
  <div class="wrap">
    <div class="flex flex-wrap gap-x-[clamp(2rem,6vw,6rem)] gap-y-6">
      <div class="flex-[1_1_min(100%,26.25rem)]">
        <SectionHeading eyebrow={eyebrow} title={title} />
      </div>
      <div class="copy max-w-[62ch] flex-[1_1_min(100%,32.5rem)] text-lead [&>*+*]:text-ink-muted">
        <slot />
      </div>
    </div>
    {
      keyFacts.length > 0 && (
        <dl class="mt-[clamp(3rem,6vw,5rem)] grid grid-cols-[repeat(auto-fit,minmax(9.375rem,1fr))] gap-px border-y border-line bg-line">
          {keyFacts.map((f) => (
            <div class="flex flex-col-reverse justify-end bg-base py-6 pr-4 pl-4 first:pl-0">
              <dt class="mt-3 text-[0.9375rem] leading-normal text-ink-muted">{f.label}</dt>
              <dd class="display text-[clamp(2.125rem,1.6rem+2vw,3.25rem)] leading-none text-brand">{f.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>
