---
/**
 * Eyebrow, h2 and optional lead. Sections take these as props so the heading
 * outline of a page stays h1 (hero) then h2 (sections) then h3 (items).
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'light' | 'dark';
}

const { eyebrow, title, lead, align = 'left', tone = 'light' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {eyebrow && <p class:list={['eyebrow', tone === 'dark' ? 'text-ondark-muted' : 'text-brand']}>{eyebrow}</p>}
  <h2 class:list={['display text-h2', eyebrow && 'mt-4']}>{title}</h2>
  {lead && <p class:list={['lead mt-4 max-w-[56ch]', tone === 'dark' && 'text-ondark-muted']}>{lead}</p>}
</div>
