---
/**
 * A link styled as a button. Every CTA on these sites goes to a page, a
 * booking engine or WhatsApp, so there is no <button> variant on purpose.
 * Heights follow the design: 48px by default, 52px on dark bands, 44px in
 * the narrow header. Never below 44px, the minimum touch target.
 */
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'onDark';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const { href, label, variant = 'primary', size = 'md', external = false, class: className } = Astro.props;

const styles = {
  primary: 'bg-brand text-onaccent hover:bg-brand-hover',
  secondary: 'border border-ink text-ink hover:bg-ink hover:text-base',
  onDark: 'bg-base text-ink hover:bg-card',
};

const sizes = {
  sm: 'min-h-11 px-[1.125rem] text-[0.9375rem]',
  md: 'min-h-12 px-6 text-[0.9375rem]',
  lg: 'min-h-[3.25rem] px-7 text-base',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center whitespace-nowrap rounded-btn font-semibold transition-colors duration-200',
    sizes[size],
    styles[variant],
    className,
  ]}
  {...external && { target: '_blank', rel: 'noopener' }}
>
  {label}
</a>
