---
import Button from '../ui/Button.astro';
import { facts } from '../../lib/facts';
import { headerCta, navItems } from '../../lib/pages';

/**
 * Header with the nav from src/lib/pages.ts. One nav for every width: a row
 * beside the logo from 900px, a second row under it below that, scrolling
 * sideways if the labels do not fit. No menu toggle, so no JavaScript.
 */
const current = Astro.url.pathname.replace(/\.html$/, '').replace(/(.)\/$/, '$1') || '/';
---

<header class="border-b border-line bg-base">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-10 min-[56.25rem]:flex-nowrap">
    <a href="/" class="display flex min-h-16 items-center text-2xl leading-none min-[56.25rem]:mr-auto min-[56.25rem]:min-h-20 min-[56.25rem]:text-[1.6875rem]">
      {facts.business.name}
    </a>

    <Button
      href={headerCta.href}
      label={headerCta.label}
      external={headerCta.external}
      size="sm"
      class="min-[56.25rem]:order-last min-[56.25rem]:min-h-12 min-[56.25rem]:px-6"
    />

    <nav aria-label="Main" class="-mx-[clamp(1.25rem,5vw,4.5rem)] w-[calc(100%+2*clamp(1.25rem,5vw,4.5rem))] overflow-x-auto px-[clamp(1.25rem,5vw,4.5rem)] min-[56.25rem]:mx-0 min-[56.25rem]:w-auto min-[56.25rem]:overflow-visible min-[56.25rem]:px-0">
      <ul class="flex gap-[1.375rem] text-[0.9375rem] min-[56.25rem]:gap-[1.875rem]">
        {
          navItems.map((item) => (
            <li class="flex-none">
              <a
                href={item.path}
                aria-current={current === item.path ? 'page' : undefined}
                class="flex min-h-11 items-center border-b-2 border-transparent hover:text-brand aria-[current=page]:border-brand"
              >
                {item.nav}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
